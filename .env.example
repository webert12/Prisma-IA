# Segredos locais: nunca envie .env ao GitHub.
SECRET_KEY=troque-por-uma-chave-aleatoria
FLASK_DEBUG=1

# Recomendado para começar sem custos: Google Gemini API (limites gratuitos sujeitos à conta/modelo).
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Alternativa opcional para APIs compatíveis com OpenAI Chat Completions:
# AI_PROVIDER=openai_compatible
# AI_API_BASE=https://api.provedor.com/v1
# AI_API_KEY=
# AI_MODEL=

# Financeiro sincronizado: use a URL do projeto e a chave anon/public do Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=

